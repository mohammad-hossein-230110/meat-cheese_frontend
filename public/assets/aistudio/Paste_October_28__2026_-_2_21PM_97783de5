  <!-- Interactive JavaScript logic -->
  <script>
    let currentCartCount = 3;

    function switchCategory(category, element) {
      // Reset all buttons
      const buttons = document.querySelectorAll('.category-btn');
      buttons.forEach(btn => {
        btn.classList.remove('bg-[#530201]', 'text-white', 'shadow-lg');
        btn.classList.add('bg-white/5', 'text-neutral-300');
      });

      // Activate clicked button
      element.classList.remove('bg-white/5', 'text-neutral-300');
      element.classList.add('bg-[#530201]', 'text-white', 'shadow-lg');
    }

    function addToCart(itemName, btnElement) {
      currentCartCount++;
      const cartCountEl = document.getElementById('cartCount');
      if (cartCountEl) {
        cartCountEl.textContent = currentCartCount;
        cartCountEl.classList.add('scale-125');
        setTimeout(() => cartCountEl.classList.remove('scale-125'), 200);
      }

      // Visual feedback on button
      const originalText = btnElement.innerHTML;
      btnElement.innerHTML = `
        <span>اضافه شد</span>
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      `;
      btnElement.classList.add('bg-neutral-800');
      
      setTimeout(() => {
        btnElement.innerHTML = originalText;
        btnElement.classList.remove('bg-neutral-800');
      }, 1200);
    }
  </script>
